# npm discards this file when package.json "files" is set. Publish exclusions live there.
# IDE and tooling
/.vscode
/.cursor
.DS_Store
.gitignore

# Source and build config (consumers use dist/)
/src
/scripts
rollup.config.mjs
tsconfig.json

# Storybook and docs site (dev-only). Component docs: package.json "files" uses docs/*.md (not the whole /docs tree).
/.storybook
/storybook-static
/website
/templates
llms.config.js

# Dependencies and lockfile
/node_modules
package-lock.json
/demos

# Declaration maps point at unpublished source and are not useful to consumers.
**/*.d.ts.map
**/*.js.map

# Dev-only emit. The converter has no runtime JS in dist; tests, stories, and fixtures are not public API.
dist/html-to-jsx
dist/test
dist/stories

# Internal release checklist. Component docs stay via package.json "files": docs/*.md
docs/PRE-TASK-20-ACCEPTANCE-CHECKLIST.md